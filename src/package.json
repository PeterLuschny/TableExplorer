{
  "name": "typetables",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild browser-api.ts --bundle --platform=browser --target=es2020 --format=iife --outfile=../public/table-explorer.bundle.js --define:require=__tableExplorerRequire --define:module=__tableExplorerModule --banner:js=\"const __tableExplorerRequire = { main: null }; const __tableExplorerModule = {};\"",
    "start:server": "ts-node --project tsconfig.server.json server.ts",
    "test": "ts-node AbelTest.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.0",
    "ts-node": "^10.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
